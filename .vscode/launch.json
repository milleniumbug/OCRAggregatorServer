    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: OCR Server",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/standalone.py",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Python: OCR Server Test Image",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/standalone.py",
            "args": ["--test-image", "${workspaceFolder}/test/00016.jpeg", "--test-image-output", "${workspaceFolder}/test-output"],
            "console": "integratedTerminal",
            "justMyCode": false
        },

        {
            "name": "Python: test.py",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/test/test.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        }
    ]
}